{
  "datasets": [
    {
      "name": "ingestion_metrics",
      "displayName": "Métricas de Ingestão",
      "config": {
        "version": "1.1",
        "source": "sample_mflix.bronze.control_ingestion_log",
        "dimensions": [
          {
            "name": "Data",
            "expr": "DATE(start_time)"
          },
          {
            "name": "Collection",
            "expr": "collection"
          },
          {
            "name": "Load Type",
            "expr": "load_type"
          },
          {
            "name": "Status",
            "expr": "status"
          }
        ],
        "measures": [
          {
            "name": "volume_total",
            "expr": "COUNT(*)"
          },
          {
            "name": "duracao_media_seg",
            "expr": "AVG(duracao_seg)"
          },
          {
            "name": "duracao_total_seg",
            "expr": "SUM(duracao_seg)"
          },
          {
            "name": "taxa_falha_pct",
            "expr": "SUM(CASE WHEN status = 'FAILED' THEN 1 ELSE 0 END) * 100.0 / COUNT(*)"
          },
          {
            "name": "qtd_falhas",
            "expr": "SUM(CASE WHEN status = 'FAILED' THEN 1 ELSE 0 END)"
          },
          {
            "name": "qtd_sucesso",
            "expr": "SUM(CASE WHEN status = 'SUCCESS' THEN 1 ELSE 0 END)"
          },
          {
            "name": "registros_lidos",
            "expr": "SUM(qtd_lida_origem)"
          },
          {
            "name": "registros_gravados",
            "expr": "SUM(qtd_gravada_destino)"
          }
        ]
      }
    }
  ],
